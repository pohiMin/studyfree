  "note": "复习不是把八个单元重刷一遍。教材把复习分成七个栏目，每个栏目对应一类能力，缺哪块补哪块，比从头刷有效率。",
  "knowledgePoints": [
    {
      "id": "math-sujiao-g3up-u9-kp1",
      "title": "数与运算",
      "short": "乘除笔算与运算顺序",
      "difficulty": 2,
      "core_concept": "这一块对应第二、第六单元，是全册最重的地基。乘法和除法两个方向都要过：进位（含连续进位）、中间或末尾有 0、首位不够除、商中间或末尾的 0。运算顺序另算一条线，对应第一单元。",
      "key_formula": "先乘除后加减；有括号先算括号；商 × 除数 + 余数 = 被除数",
      "common_mistakes": [
        "连续进位时漏加一次进位",
        "乘数中间有 0 直接跳过",
        "首位不够除时把商写在百位上",
        "商的中间或末尾漏写 0"
      ],
      "tips": "复习时不要平均用力。先把乘除笔算练到不出错，再回头看运算顺序。",
      "questions": [
        {
          "type": "input",
          "difficulty": 2,
          "question": "计算：320×3 =（  ）",
          "answer": "960",
          "unit": "",
          "explanation": "先算 32×3=96，末尾补 1 个 0，得 960。"
        },
        {
          "type": "input",
          "difficulty": 3,
          "question": "计算：405×6 =（  ）",
          "answer": "2430",
          "unit": "",
          "explanation": "6×5=30 写 0 进 3；6×0=0，0+3=3；6×4=24。得 2430。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "计算：840÷6 =（  ）",
          "answer": "140",
          "unit": "",
          "explanation": "8÷6=1 余 2，2 和 4 合成 24，24÷6=4，个位 0÷6=0。得 140。"
        },
        {
          "type": "input",
          "difficulty": 3,
          "question": "计算：618÷3 =（  ）",
          "answer": "206",
          "unit": "",
          "explanation": "6÷3=2；十位 1 比 3 小商 0；18÷3=6。得 206。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "计算：256÷4 =（  ）",
          "answer": "64",
          "unit": "",
          "explanation": "2 比 4 小，看 25。25÷4=6 余 1，1 和 6 合成 16，16÷4=4。得 64。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "计算：72-6×8 =（  ）",
          "answer": "24",
          "unit": "",
          "explanation": "先算乘法 6×8=48，再算 72-48=24。"
        },
        {
          "type": "input",
          "level": "advance",
          "difficulty": 3,
          "question": "计算：250×4 =（  ）",
          "answer": "1000",
          "explanation": "25×4=100，添一个 0 得 1000。乘法末尾 0 的处理。"
        },
        {
          "type": "input",
          "level": "advance",
          "difficulty": 3,
          "question": "计算：612÷6 =（  ）",
          "answer": "102",
          "explanation": "十位不够除商 0 占位。商中间的 0 不能漏。"
        },
        {
          "type": "true_false",
          "level": "advance",
          "difficulty": 3,
          "question": "计算 305×4 和 350×4，积一样大。",
          "answer": "错",
          "explanation": "305×4=1220，350×4=1400。0 的位置不同，结果完全不同。"
        }
      ]
    },
    {
      "id": "math-sujiao-g3up-u9-kp2",
      "title": "时间单位与质量单位",
      "short": "两类单位都别混",
      "difficulty": 2,
      "core_concept": "时间这块对应第一单元的「一天的时间」：24 时记时法、经过的时间。质量单位对应第二单元的「曹冲称象」：克、千克、吨，每两级都是 1000。两类单位都要能选对、能换算。",
      "key_formula": "1 千克 = 1000 克；1 吨 = 1000 千克；下午时刻 + 12 = 24 时记时法",
      "common_mistakes": [
        "上午的时刻也加 12",
        "计算经过时间时跨中午直接相减",
        "质量单位选得离谱",
        "把千克和克的进率记成 100"
      ],
      "tips": "时间题画时间轴，单位题先想实物大小。两个办法都很土，但最管用。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "下午 4 时用 24 时记时法表示是（  ）",
          "options": [
            "4 时",
            "14 时",
            "16 时"
          ],
          "answer": "C",
          "explanation": "4+12=16，所以是 16 时。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "从 8:20 到 9:05，经过了（  ）分钟。",
          "answer": "45",
          "unit": "分钟",
          "explanation": "8:20 到 9:00 是 40 分钟，9:00 到 9:05 是 5 分钟，一共 45 分钟。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "3 千克 =（  ）克",
          "answer": "3000",
          "unit": "",
          "explanation": "1 千克 = 1000 克，3 千克 = 3000 克。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "5000 千克 =（  ）吨",
          "answer": "5",
          "unit": "",
          "explanation": "1000 千克是 1 吨，5000 千克里有 5 个 1000。"
        },
        {
          "type": "choice",
          "difficulty": 1,
          "question": "一辆卡车的载重量大约是 5（  ）",
          "options": [
            "克",
            "千克",
            "吨"
          ],
          "answer": "C",
          "explanation": "卡车载重很大，用吨。5 吨 = 5000 千克。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "一场电影 19:00 开始，20:40 结束，放映了多长时间？",
          "options": [
            "1 小时 40 分",
            "2 小时 40 分",
            "1 小时 20 分"
          ],
          "answer": "A",
          "explanation": "19:00 到 20:00 是 1 小时，20:00 到 20:40 是 40 分钟，共 1 小时 40 分。"
        },
        {
          "type": "input",
          "level": "advance",
          "difficulty": 3,
          "question": "一场电影从 14:30 开始，播放 110 分钟，结束时刻是 ____。（按 24 时记时法填，如 16:20）",
          "answer": "16:20",
          "explanation": "14:30 + 110 分钟 = 14:30 + 1 小时 50 分 = 16:20。"
        },
        {
          "type": "input",
          "level": "advance",
          "difficulty": 3,
          "question": "2 吨 = ____ 千克；4000 克 = ____ 千克。（按「x千克和y千克」格式填）",
          "answer": "2000千克和4千克",
          "explanation": "1 吨=1000 千克，2 吨=2000 千克；1000 克=1 千克，4000 克=4 千克。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 3,
          "question": "小明晚上 9 点睡觉（21:00），第二天早上 7 点起床（7:00），他睡了多长时间？",
          "options": [
            "10 小时",
            "9 小时",
            "12 小时"
          ],
          "answer": "A",
          "explanation": "21:00 到 24:00 是 3 小时，0:00 到 7:00 是 7 小时，共 10 小时。跨天要分段算。"
        }
      ]
    },
    {
      "id": "math-sujiao-g3up-u9-kp3",
      "title": "数量关系",
      "short": "两步问题找中间量",
      "difficulty": 3,
      "core_concept": "对应第一、第七单元。两步计算的问题，中间一定有一个必须先求出来的量。可以从条件往前推，也可以从问题往回找，两条路都行。关键不是算得快，是先想清楚先求什么。",
      "key_formula": "找出中间量 → 先求中间量 → 再求最终答案",
      "common_mistakes": [
        "看到数字就凑算式",
        "少算一步就写答案",
        "中间量求出来了，最后却没用上"
      ],
      "tips": "动笔前用一句话说出「我先求什么，再求什么」，说不出来就别急着算。",
      "questions": [
        {
          "type": "input",
          "difficulty": 2,
          "question": "每盒 12 支，买了 5 盒，用去 18 支。还剩多少支？（只填数字，单位：支）",
          "answer": "42",
          "unit": "支",
          "explanation": "中间量是总数：12×5=60（支）；再算 60-18=42（支）。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "一班 38 人，二班比一班多 4 人。两个班一共多少人？（只填数字，单位：人）",
          "answer": "80",
          "unit": "人",
          "explanation": "先求二班：38+4=42（人）；再算 38+42=80（人）。"
        },
        {
          "type": "input",
          "difficulty": 3,
          "question": "一本书 120 页，看了 5 天，每天看 18 页。还剩多少页？（只填数字，单位：页）",
          "answer": "30",
          "unit": "页",
          "explanation": "中间量是已看页数：5×18=90（页）；再算 120-90=30（页）。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "要求「还剩多少」，必须知道（  ）",
          "options": [
            "总数和已经用掉的",
            "只有总数",
            "只有用掉的"
          ],
          "answer": "A",
          "explanation": "剩下 = 总数 − 已用，两个条件缺一不可。"
        },
        {
          "type": "input",
          "difficulty": 3,
          "question": "三年级 4 个班，每班 45 人，平均分成 9 队。每队多少人？（只填数字，单位：人）",
          "answer": "20",
          "unit": "人",
          "explanation": "中间量是总人数：4×45=180（人）；再算 180÷9=20（人）。"
        },
        {
          "type": "input",
          "level": "advance",
          "difficulty": 3,
          "question": "商店上午卖出 4 箱饮料，每箱 24 瓶，下午卖出 50 瓶，全天一共卖出 ____ 瓶。",
          "answer": "146",
          "explanation": "先算上午：24×4=96（瓶），再加下午：96+50=146（瓶）。"
        },
        {
          "type": "input",
          "level": "advance",
          "difficulty": 3,
          "question": "食堂运来 500 千克大米，每天吃 45 千克，吃了 6 天，还剩 ____ 千克。",
          "answer": "230",
          "explanation": "先算吃了：45×6=270（千克），再算剩下：500-270=230（千克）。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 3,
          "question": "『每盒 6 个乒乓球，8 盒一共 48 个』。要表示『盒数多、每盒个数少、总数大』的关系，最好的办法是：",
          "options": [
            "列一个乘法算式 6×8=48",
            "写成加法",
            "背口诀"
          ],
          "answer": "A",
          "explanation": "乘法算式就是数量关系的浓缩表达：每份数×份数=总数。"
        }
      ]
    },
    {
      "id": "math-sujiao-g3up-u9-kp4",
      "title": "图形的认识与测量",
      "short": "长度单位与量感",
      "difficulty": 2,
      "core_concept": "对应第四单元。毫米、厘米、分米、米、千米，相邻四个之间都是 10，只有米到千米是 1000。这单元真正难的不是换算，是「填合适单位」——那要靠对实物大小的感觉。",
      "key_formula": "1 千米 = 1000 米；1 米 = 10 分米 = 100 厘米；1 分米 = 10 厘米；1 厘米 = 10 毫米",
      "common_mistakes": [
        "把米和千米的进率记成 100",
        "填单位时选得离谱",
        "跨级换算时倍数算少"
      ],
      "tips": "记住三个参照：指甲宽约 1 厘米，手掌宽约 1 分米，课桌高约 7 分米。",
      "questions": [
        {
          "type": "input",
          "difficulty": 1,
          "question": "1 米 =（  ）厘米",
          "answer": "100",
          "unit": "",
          "explanation": "1 米 = 10 分米 = 100 厘米。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "60 毫米 =（  ）厘米",
          "answer": "6",
          "unit": "",
          "explanation": "10 毫米是 1 厘米，60 毫米里有 6 个 10。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "3 千米 =（  ）米",
          "answer": "3000",
          "unit": "",
          "explanation": "1 千米 = 1000 米，3 千米 = 3000 米。"
        },
        {
          "type": "choice",
          "difficulty": 1,
          "question": "教室的门高约 2（  ）",
          "options": [
            "分米",
            "米",
            "千米"
          ],
          "answer": "B",
          "explanation": "门高约 2 米，比大人高一点。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "5 分米 =（  ）厘米",
          "answer": "50",
          "unit": "",
          "explanation": "1 分米 = 10 厘米，5 分米 = 50 厘米。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 3,
          "question": "一根 3 分米的木条，接上一段 20 厘米的木条，总长是：",
          "options": [
            "50 厘米",
            "32 厘米",
            "23 分米"
          ],
          "answer": "A",
          "explanation": "3 分米=30 厘米，30+20=50（厘米）。先统一单位。"
        },
        {
          "type": "input",
          "level": "advance",
          "difficulty": 3,
          "question": "5 千米-2000 米 = ____ 千米。（填数字）",
          "answer": "3",
          "explanation": "2000 米=2 千米，5-2=3（千米）。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 3,
          "question": "下面长度中最短的是：",
          "options": [
            "990 毫米",
            "1 米",
            "90 厘米"
          ],
          "answer": "A",
          "explanation": "990 毫米=99 厘米，比 90 厘米长，但比 1 米（100 厘米）短。先统一成厘米比较：99>90，但 99<100。"
        }
      ]
    },
    {
      "id": "math-sujiao-g3up-u9-kp5",
      "title": "图形的位置与运动",
      "short": "平移、旋转、对称轴",
      "difficulty": 2,
      "core_concept": "对应第五、第八单元。平移是沿直线走、方向不变；旋转是绕一个点转；轴对称是沿一条直线对折能完全重合。观察物体则是从不同方向看到不同形状。这几块都靠辨认和想象，不靠计算。",
      "key_formula": "平移：直线 + 方向不变；旋转：绕点转；轴对称：对折完全重合",
      "common_mistakes": [
        "对称轴条数数错（正方形 4 条、长方形 2 条、圆无数条）",
        "把直线滑动当成旋转",
        "以为一个视图就能确定物体"
      ],
      "tips": "对称轴拿纸折一折，比盯着看图快得多，也不容易数错。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "电梯上下移动属于（  ）",
          "options": [
            "平移",
            "旋转"
          ],
          "answer": "A",
          "explanation": "沿直线上下、方向不变，是平移。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "正方形有几条对称轴？",
          "options": [
            "2 条",
            "4 条",
            "无数条"
          ],
          "answer": "B",
          "explanation": "横、竖两条，再加两条对角线，共 4 条。"
        },
        {
          "type": "true_false",
          "difficulty": 1,
          "question": "平移时物体的方向不变。",
          "answer": "对",
          "explanation": "方向变了就属于旋转了。"
        },
        {
          "type": "choice",
          "difficulty": 1,
          "question": "风车转动属于（  ）",
          "options": [
            "平移",
            "旋转"
          ],
          "answer": "B",
          "explanation": "风车绕中心轴转动，是旋转。"
        },
        {
          "type": "true_false",
          "difficulty": 2,
          "question": "圆有无数条对称轴。",
          "answer": "对",
          "explanation": "过圆心的任意直线都是对称轴。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 3,
          "question": "开冰箱门、拉窗帘、拧螺丝，属于旋转的有几个？",
          "options": [
            "2 个（开冰箱门、拧螺丝）",
            "1 个",
            "3 个"
          ],
          "answer": "A",
          "explanation": "开冰箱门绕轴转、拧螺丝绕中心转，是旋转；拉窗帘沿直线移动，是平移。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 3,
          "question": "下面三个图案：奥运五环、五角星、一片对称的银杏叶。按轮廓形状判断，是轴对称图形的有：",
          "options": [
            "3 个都是",
            "只有五角星",
            "只有银杏叶"
          ],
          "answer": "A",
          "explanation": "三个图案沿中线对折，轮廓都能完全重合，都是轴对称图形。注意看的是轮廓形状，不看颜色。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 3,
          "question": "电梯从 1 楼到 5 楼是平移，那么电梯门的开和关是：",
          "options": [
            "平移（左右滑动门）或旋转（转轴门），取决于门的类型",
            "一定是旋转",
            "一定是平移"
          ],
          "answer": "A",
          "explanation": "滑动门是平移，转轴门是旋转。判断运动类型要看实际怎么动。"
        }
      ]
    },
    {
      "id": "math-sujiao-g3up-u9-kp6",
      "title": "数据的收集、整理与表达",
      "short": "记录、合计、读表",
      "difficulty": 2,
      "core_concept": "对应第三单元。收集数据先想清楚调查什么、调查谁；记录数据用「正」字最方便，一个「正」等于 5；整理成统计表后，就能回答最多、最少、相差多少、一共多少。",
      "key_formula": "1 个「正」= 5；合计 = 各项之和；相差 = 最多 − 最少",
      "common_mistakes": [
        "把「正」字当成 4 个或 10 个",
        "数的时候漏掉不满一个「正」的笔画",
        "合计算漏一项"
      ],
      "tips": "数「正」字记录时，先五个一组数，剩下的笔画再一个个加。",
      "questions": [
        {
          "type": "input",
          "difficulty": 1,
          "question": "用「正」字记录，3 个「正」字表示（  ）个。",
          "answer": "15",
          "unit": "",
          "explanation": "一个「正」字 5 个，3×5=15。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "统计表里三项分别是 12、9、15，合计是（  ）。",
          "answer": "36",
          "unit": "",
          "explanation": "12+9+15=36。"
        },
