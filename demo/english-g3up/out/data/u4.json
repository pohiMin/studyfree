  "note": "Big question: How do you introduce your friends?（怎样介绍你的朋友）",
  "knowledgePoints": [
    {
      "id": "english-yilin-3a-u4-kp1",
      "title": "介绍朋友：This is…",
      "short": "把朋友带来认识",
      "difficulty": 2,
      "sections": [
        "This is Sam",
        "Introduce a friend"
      ],
      "core_concept": "介绍朋友用 This is…（这位是……）：This is Sam. This is my friend Zhang Hua. 介绍完，两人会互相问好：Hello! / Hi! Nice to meet you!",
      "key_formula": "介绍：This is + 名字 ／ This is my friend + 名字",
      "common_mistakes": [
        "介绍人用 He is…——对朋友当面介绍要用 This is…",
        "friend 拼错（少 d）",
        "介绍完忘了让两人问好"
      ],
      "tips": "This is… 是介绍人的万能句：This is my friend / my teacher / my dad.",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "把朋友 Sam 介绍给妈妈，应该说：",
          "options": [
            "Mum, this is my friend Sam.",
            "Mum, he friend Sam.",
            "Mum, I'm Sam."
          ],
          "answer": "A",
          "explanation": "介绍人用 This is…。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "—This is Mike. —______",
          "options": [
            "Hello, Mike! Nice to meet you.",
            "Goodbye!",
            "What?"
          ],
          "answer": "A",
          "explanation": "被介绍后要问好。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "填空：______ is my friend Liu Tao.（填一个词：这）",
          "answer": "this",
          "explanation": "This is… 这位是……（大小写不限）。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "写词：朋友",
          "answer": "friend",
          "explanation": "friend：朋友。"
        },
        {
          "type": "true_false",
          "difficulty": 2,
          "question": "介绍朋友时说 This is my friend Zhang Hua. 是对的。",
          "answer": "对",
          "explanation": "This is my friend + 名字。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "介绍之后，两个人应该：",
          "options": [
            "互相问好",
            "马上分开",
            "不说话"
          ],
          "answer": "A",
          "explanation": "介绍完互相问好，认识才完成。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "把两个朋友互相介绍，正确顺序是：",
          "options": [
            "先介绍 A 给 B，再让 A 和 B 问好",
            "让 A 自己说",
            "不介绍"
          ],
          "answer": "A",
          "explanation": "介绍完要留出两人互相问好的机会。"
        },
        {
          "type": "input",
          "level": "challenge",
          "difficulty": 3,
          "question": "把老师介绍给爸爸：—Dad, ______ my teacher, Miss Li.",
          "answer": "this is",
          "explanation": "This is… 介绍人的万能句。"
        }
      ]
    },
    {
      "id": "english-yilin-3a-u4-kp2",
      "title": "初次见面的问候：Nice to meet you.",
      "short": "很高兴认识你",
      "difficulty": 2,
      "sections": [
        "This is Zhang Hua"
      ],
      "core_concept": "第一次见面说 Nice to meet you.（很高兴认识你），回答加 too：Nice to meet you, too.（我也很高兴认识你）。too 的意思是『也』，别忘了写。",
      "key_formula": "A: Nice to meet you. → B: Nice to meet you, too.",
      "common_mistakes": [
        "回答忘了 too",
        "meet 写成 meat（肉）",
        "too 写成 to 或 two"
      ],
      "tips": "too＝也：他说很高兴认识你，你说『我也』——加 too。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "别人对你说 Nice to meet you. 你回答：",
          "options": [
            "Nice to meet you, too.",
            "Good morning.",
            "What's your name?"
          ],
          "answer": "A",
          "explanation": "回答要加 too。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "填空：Nice to meet you, ______.（也）",
          "answer": "too",
          "explanation": "too：也。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "Nice to meet you. 用于：",
          "options": [
            "第一次见面",
            "每天说再见",
            "上课回答问题"
          ],
          "answer": "A",
          "explanation": "初次见面专用问候语。"
        },
        {
          "type": "true_false",
          "difficulty": 1,
          "question": "Nice to meet you, too. 的意思是『我也很高兴认识你』。",
          "answer": "对",
          "explanation": "too 表示『也』。"
        },
        {
          "type": "choice",
          "difficulty": 3,
          "question": "妈妈把你介绍给王阿姨，你先说：",
          "options": [
            "Nice to meet you, Aunt Wang.",
            "Bye!",
            "What?"
          ],
          "answer": "A",
          "explanation": "被介绍后先问好。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "写词：遇见（一个词，Nice to ______ you.）",
          "answer": "meet",
          "explanation": "meet：遇见。注意不是 meat（肉）。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "Nice to meet you, too. 里的 too 可以换成：",
          "options": [
            "also（也），但 too 更常用",
            "two（二）",
            "to"
          ],
          "answer": "A",
          "explanation": "too 也、also 也，意思一样，too 更口语。注意和 two（二）、to（到）区分。"
        },
        {
          "type": "input",
          "level": "challenge",
          "difficulty": 3,
          "question": "填对话：—Mum, this is my friend. —Nice to meet you. —____",
          "answer": "Nice to meet you, too",
          "explanation": "朋友回应妈妈的问候，要加 too。"
        }
      ]
    },
    {
      "id": "english-yilin-3a-u4-kp3",
      "title": "字母 Ll Mm Nn",
      "short": "拼到 N 了",
      "difficulty": 1,
      "sections": [
        "Letters in focus"
      ],
      "core_concept": "本单元学三个字母：Ll Mm Nn。到此 Module 1 的 14 个字母（Aa—Nn）全部学完。M 和 N 读音相近（[em]／[en]），要听清；L 的小写 l 像一根竖线。",
      "key_formula": "字母表：J K L M N ——A 到 N 共 14 个，Module 1 全部学完",
      "common_mistakes": [
        "M 和 N 听音混淆",
        "N 写反（斜线方向）",
        "背到 N 后面接了 O 却忘了 M 前面是 L"
      ],
      "tips": "快听快指：老师说 M 或 N，你举卡片，练三遍就分清了。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "L 的后面一个字母是：",
          "options": [
            "M",
            "N",
            "K"
          ],
          "answer": "A",
          "explanation": "L M N。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "填字母：J K ____ M N（填大写）",
          "answer": "L",
          "explanation": "J K L M N。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "N 的前面一个字母是：",
          "options": [
            "M",
            "L",
            "O"
          ],
          "answer": "A",
          "explanation": "M N。"
        },
        {
          "type": "choice",
          "difficulty": 3,
          "question": "Module 1 学过的字母一共有多少个（Aa—Nn）？",
          "options": [
            "14 个",
            "12 个",
            "16 个"
          ],
          "answer": "A",
          "explanation": "A 到 N 共 14 个字母。"
        },
        {
          "type": "true_false",
          "difficulty": 1,
          "question": "M 和 N 的读音完全相同。",
          "answer": "错",
          "explanation": "M [em]，N [en]，读音不同，要听清。"
        },
        {
          "type": "input",
          "difficulty": 3,
          "question": "填字母：A B C D E F G H I ____ K L M N（填大写）",
          "answer": "J",
          "explanation": "A 到 N 的完整顺序。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "M 和 N 读音相近，区分它们最好的办法是：",
          "options": [
            "多听多读，注意尾音 em 和 en",
            "随便猜",
            "只看口型"
          ],
          "answer": "A",
          "explanation": "多听多读是最有效的区分方法。"
        },
        {
          "type": "input",
          "level": "challenge",
          "difficulty": 3,
          "question": "填字母：K ____ M N（填大写）",
          "answer": "L",
          "explanation": "K L M N。"
        }
      ]
    },
    {
      "id": "english-yilin-3a-u4-kp4",
      "title": "介绍场景：在家和在学校",
      "short": "换个人也称得上",
      "difficulty": 2,
      "sections": [
        "This is Sam",
        "This is Zhang Hua"
      ],
      "core_concept": "介绍词 This is… 什么人都能介绍：This is my friend.（我的朋友）This is my teacher.（我的老师）课文里 Sam 把张华介绍给 Bobby。介绍是友谊的桥梁，声音要响亮、大方。",
      "key_formula": "This is my + friend／teacher／dad／mum +（名字）",
      "common_mistakes": [
        "my（我的）和 me（我）用混",
        "介绍时声音太小",
        "介绍完自己先走了"
      ],
      "tips": "介绍完站在两位朋友中间，等他们互相问好。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "介绍你的老师，说：",
          "options": [
            "This is my teacher, Miss Li.",
            "This is me teacher.",
            "She is I teacher."
          ],
          "answer": "A",
          "explanation": "This is my + 身份 + 名字。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "my 的意思是：",
          "options": [
            "我的",
            "我",
            "你的"
          ],
          "answer": "A",
          "explanation": "my：我的，后面接名词。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "填空：This is ______ friend Sam.（我的）",
          "answer": "my",
          "explanation": "my friend 我的朋友。"
        },
        {
          "type": "true_false",
          "difficulty": 1,
          "question": "介绍别人时声音要响亮、大方。",
          "answer": "对",
          "explanation": "介绍是有礼貌的社交行为。"
        },
        {
          "type": "choice",
          "difficulty": 3,
          "question": "Bobby 把 Sam 介绍给张华后，最完整的一轮对话是：",
          "options": [
            "—Hello, Sam! —Hello, Zhang Hua! Nice to meet you!",
            "—Bye! —Bye!",
            "—What? —OK."
          ],
          "answer": "A",
          "explanation": "互相问好加 Nice to meet you。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "写词：老师（一个词，与 Miss Li 对应的职业）",
          "answer": "teacher",
          "explanation": "teacher：老师。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "This is my dad. 和 This is my teacher. 说明 This is… 后面可以接：",
          "options": [
            "各种人物",
            "只能接朋友",
            "只能接家人"
          ],
          "answer": "A",
          "explanation": "This is… 是万能介绍句。"
        },
        {
          "type": "input",
          "level": "challenge",
          "difficulty": 3,
          "question": "介绍完说：____ to meet you! 由被介绍的人说。",
          "answer": "nice",
          "explanation": "被介绍后双方互道 Nice to meet you.。"
        }
      ]
    }
