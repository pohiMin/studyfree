    {
      "id": "english-yilin-3a-u6-kp2",
      "title": "家人的称呼与家谱",
      "short": "三代一家人",
      "difficulty": 2,
      "sections": [
        "确认家人关系",
        "我的家谱图"
      ],
      "core_concept": "家里有 father 和 mother，他们的爸爸是我们的 grandpa，妈妈是 grandma。爸爸的哥哥是 uncle（叔叔），妈妈的姐妹是 aunt（阿姨）。画出家谱图，把每个人放在格子里，关系就清楚了。",
      "key_formula": "家谱三层：grandpa／grandma → father·mother·uncle·aunt → brother·sister·me",
      "common_mistakes": [
        "uncle 和 aunt 用反（uncle 男，aunt 女）",
        "grandparents 指祖父母两人，不是一人",
        "拼 uncle 写成 ancle"
      ],
      "tips": "画一张三层家谱图贴在书桌上，每天用英语说一遍。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "aunt 的意思是：",
          "options": [
            "阿姨、姑姑",
            "叔叔、舅舅",
            "爷爷"
          ],
          "answer": "A",
          "explanation": "aunt：女性长辈；uncle：男性长辈。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "叔叔或舅舅的英语是：",
          "options": [
            "uncle",
            "aunt",
            "grandpa"
          ],
          "answer": "A",
          "explanation": "uncle：男性长辈。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "写词：奶奶（一个词）",
          "answer": "grandma",
          "explanation": "grandma：奶奶／外婆。"
        },
        {
          "type": "choice",
          "difficulty": 3,
          "question": "father 的 father 是你的：",
          "options": [
            "grandpa",
            "brother",
            "uncle"
          ],
          "answer": "A",
          "explanation": "爸爸的爸爸是爷爷 grandpa。"
        },
        {
          "type": "true_false",
          "difficulty": 2,
          "question": "uncle 指女性长辈。",
          "answer": "错",
          "explanation": "uncle 是男性长辈，aunt 是女性长辈。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "写词：阿姨或姑姑（一个词）",
          "answer": "aunt",
          "explanation": "aunt：阿姨／姑姑。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "father 的 brother 是你的：",
          "options": [
            "uncle",
            "aunt",
            "grandpa"
          ],
          "answer": "A",
          "explanation": "爸爸的兄弟是叔叔或伯伯，都是 uncle。"
        },
        {
          "type": "input",
          "level": "challenge",
          "difficulty": 3,
          "question": "家谱三层，中间一层有 father、mother 和 ____、____。（按「词1和词2」格式填）",
          "answer": "uncle和aunt",
          "explanation": "中间一层是父母辈：father、mother、uncle、aunt。"
        }
      ]
    },
    {
      "id": "english-yilin-3a-u6-kp3",
      "title": "我的家：用英语说一说",
      "short": "连句成段",
      "difficulty": 3,
      "sections": [
        "我的家谱图"
      ],
      "core_concept": "把句子连起来介绍全家：This is my family. Look! He's my father. She's my mother. This is me.（这是我的家。看！他是我爸爸。她是我妈妈。这是我。）一次说三句以上，就是一段小小的英语介绍。",
      "key_formula": "开头：This is my family. ／ 中间：He's/She's my… ×2 ／ 结尾：This is me.",
      "common_mistakes": [
        "句子之间没有停顿，一口气念完",
        "每句开头忘记大写",
        "结尾忘了 This is me."
      ],
      "tips": "对着全家福练三句连说，说熟了就到学校说给同学听。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 2,
          "question": "介绍全家的开头一句是：",
          "options": [
            "This is my family.",
            "I'm family.",
            "Look my family."
          ],
          "answer": "A",
          "explanation": "This is my family. 这是我的家。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "填空：______ is me.（介绍完家人最后说自己）",
          "answer": "this",
          "explanation": "This is me. 这是我。（大小写不限）"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "Look! 的意思是：",
          "options": [
            "看！",
            "听！",
            "走吧！"
          ],
          "answer": "A",
          "explanation": "Look!：看！用来引起注意。"
        },
        {
          "type": "true_false",
          "difficulty": 1,
          "question": "介绍全家时，介绍完自己家人还要介绍自己（This is me.）。",
          "answer": "对",
          "explanation": "别忘了照片里还有你自己。"
        },
        {
          "type": "choice",
          "difficulty": 3,
          "question": "下面哪段介绍最完整？",
          "options": [
            "This is my family. Look! He's my father. She's my mother. This is me.",
            "My father. My mother.",
            "Family! Family!"
          ],
          "answer": "A",
          "explanation": "A 有开头、有介绍、有结尾，连句成段。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "写词：看（一个词，引起别人注意）",
          "answer": "look",
          "explanation": "look：看。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "介绍全家时说 Look! 的作用是：",
          "options": [
            "提醒别人看",
            "提醒别人听",
            "说再见"
          ],
          "answer": "A",
          "explanation": "Look!：看！引起注意。"
        },
        {
          "type": "input",
          "level": "challenge",
          "difficulty": 3,
          "question": "连句成段：This is my family. → She's my mother. → He's my father. → ______（最后一句）",
          "answer": "This is me.",
          "explanation": "介绍完家人最后介绍自己。"
        }
      ]
    },
    {
      "id": "english-yilin-3a-u6-kp4",
      "title": "字母滚动：Oo Pp Qq 认读",
      "short": "过了半程",
      "difficulty": 2,
      "sections": [
        "Letters in focus"
      ],
      "core_concept": "字母走到 Oo Pp Qq。O 是一个大圆圈；P 在 O 下面加了一条腿；Q 是 O 加了一条小尾巴。三个长得像，要用笔写一写来区分。注意 Q 和 O 都带圈，Q 有尾巴。",
      "key_formula": "字母表：…N O P Q R…",
      "common_mistakes": [
        "O 和 Q 不分（Q 有尾巴）",
        "P 和 q 大小写混",
        "Q 忘写小尾巴"
      ],
      "tips": "口诀：O 是光头圆又圆，P 接拐棍站上边，Q 拖尾巴跑得欢。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "O 的后面一个字母是：",
          "options": [
            "P",
            "Q",
            "N"
          ],
          "answer": "A",
          "explanation": "O P Q。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "填字母：O ____ Q（填大写）",
          "answer": "P",
          "explanation": "O P Q。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "下面哪个是字母 Q？",
          "options": [
            "Q（带小尾巴）",
            "O",
            "G"
          ],
          "answer": "A",
          "explanation": "Q 是 O 加小尾巴。"
        },
        {
          "type": "true_false",
          "difficulty": 1,
          "question": "O 和 Q 完全一样。",
          "answer": "错",
          "explanation": "Q 有小尾巴。"
        },
        {
          "type": "choice",
          "difficulty": 3,
          "question": "P 的前面一个字母是：",
          "options": [
            "O",
            "Q",
            "N"
          ],
          "answer": "A",
          "explanation": "O P。"
        },
        {
          "type": "input",
          "difficulty": 3,
          "question": "填字母：N O P ____（填大写）",
          "answer": "Q",
          "explanation": "N O P Q。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "P 和 Q 的区别是：",
          "options": [
