    {
      "id": "english-yilin-3a-u2-kp2",
      "title": "认识新同学",
      "short": "New classmate",
      "difficulty": 1,
      "sections": [
        "A new classmate"
      ],
      "core_concept": "班里来了新同学，要主动打招呼：Hello! Welcome to our class.（欢迎来到我们班）欢迎别人可以说 Welcome!。认识新朋友要先问好、再问名字，一起玩时会说 Let's play!（我们一起玩吧）",
      "key_formula": "见面：Hello! → 问名字：What's your name? → 欢迎：Welcome to our class!",
      "common_mistakes": [
        "只顾自己玩，不和新同学说话",
        "Welcome 拼写成 Wellcome",
        "our（我们的）和 your（你们的）用混"
      ],
      "tips": "对新同学微笑着说 Hello，友谊就从这句话开始。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "新同学来了，最热情的欢迎语是：",
          "options": [
            "Welcome to our class!",
            "Goodbye!",
            "What?"
          ],
          "answer": "A",
          "explanation": "Welcome to our class. 欢迎来到我们班。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "邀请新同学一起玩，可以说：",
          "options": [
            "Let's play!",
            "You go!",
            "My name is…"
          ],
          "answer": "A",
          "explanation": "Let's play! 我们一起玩吧。Let's = Let us。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "填空：Welcome to ______ class.（我们的班级，填一个词）",
          "answer": "our",
          "explanation": "our 我们的；your 你们的。"
        },
        {
          "type": "true_false",
          "difficulty": 1,
          "question": "认识新朋友可以先打招呼，再问名字。",
          "answer": "对",
          "explanation": "先问好再问名字，有礼貌。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "新同学说 I'm Beibei. 你回答：",
          "options": [
            "Hi, Beibei! Welcome!",
            "Goodbye!",
            "What's this?"
          ],
          "answer": "A",
          "explanation": "叫出对方名字并欢迎，最友好。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "写词：朋友（一个词）",
          "answer": "friend",
          "explanation": "friend：朋友。别忘了结尾的 d。"
        },
        {
          "type": "choice",
          "level": "advance",
          "difficulty": 2,
          "question": "新同学一个人站在门口，最好的做法是：",
          "options": [
            "主动说 Hello! 欢迎他",
            "当作没看见",
            "跟别人说他"
          ],
          "answer": "A",
          "explanation": "主动友爱，友谊从第一句话开始。"
        },
        {
          "type": "input",
          "level": "challenge",
          "difficulty": 3,
          "question": "对新同学说三句话（按顺序）：Hello! → What's your name? → ______",
          "answer": "Welcome to our class!",
          "explanation": "答案不唯一：欢迎、邀请一起玩都合适。"
        }
      ]
    },
    {
