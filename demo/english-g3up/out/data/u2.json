    {
      "id": "english-yilin-3a-u2-kp1",
      "title": "问名字：What's your name?",
      "short": "礼貌地问",
      "difficulty": 1,
      "sections": [
        "My name is Beibei",
        "Make new friends"
      ],
      "core_concept": "问别人叫什么：What's your name?（你叫什么名字？）回答用 My name is… 或 I'm…。What's 是 What is 的缩写。问别人名字时要有礼貌，不能命令。",
      "key_formula": "What's your name? → My name is… ／ I'm…",
      "common_mistakes": [
        "What's 写成 Whats（丢撇号）",
        "your（你的）和 you（你）用混",
        "回答时说 My name is 你自己的名字——注意要答对方问的名字"
      ],
      "tips": "What's your name? 读三遍，注意 What's 读成一个词 [wɒts]。",
      "questions": [
        {
          "type": "choice",
          "difficulty": 1,
          "question": "想问新同学叫什么名字，应该说：",
          "options": [
            "What's your name?",
            "How are you?",
            "Goodbye!"
          ],
          "answer": "A",
          "explanation": "What's your name? 你叫什么名字？"
        },
        {
          "type": "choice",
          "difficulty": 1,
          "question": "What's your name? 的回答是：",
          "options": [
            "My name is Liu Tao.",
            "I'm fine.",
            "Good morning."
          ],
          "answer": "A",
          "explanation": "用 My name is… 或 I'm… 回答。"
        },
        {
          "type": "input",
          "difficulty": 1,
          "question": "填空：______ your name?（问名字，用缩写）",
          "answer": "What's",
          "explanation": "What's your name? What's = What is。"
        },
        {
          "type": "choice",
          "difficulty": 2,
          "question": "What's 是哪两个词的缩写？",
          "options": [
            "What is",
            "What was",
            "What has"
          ],
          "answer": "A",
          "explanation": "What's = What is。"
        },
        {
          "type": "input",
          "difficulty": 2,
          "question": "填空：My name ______ Wang Bing.（填一个词）",
          "answer": "is",
          "explanation": "My name is… 名字是第三人称单数，用 is。"
        },
        {
          "type": "true_false",
          "difficulty": 2,
          "question": "问别人名字时可以不礼貌地喊：喂，你叫什么！",
