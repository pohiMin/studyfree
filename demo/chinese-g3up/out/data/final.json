            ],
            "answer": "A",
            "explanation": "衔：用嘴叼。"
          },
          {
            "type": "choice",
            "question": "他____不犹豫地冲上去。",
            "options": [
              "毫",
              "豪",
              "亳"
            ],
            "answer": "A",
            "explanation": "毫不犹豫的毫下面是毛；豪下面是豕（自豪）；亳读 bó，是地名用字（安徽亳州），下面比毫少一横。"
          },
          {
            "type": "choice",
            "question": "那里非常____险。",
            "options": [
              "危",
              "威",
              "微"
            ],
            "answer": "A",
            "explanation": "危险。"
          }
        ]
